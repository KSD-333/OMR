<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused State -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/bg_dark_input" />
            <stroke android:width="1.5dp" android:color="@color/dashboard_card_teal" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Default State -->
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/border_dark" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused State -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/bg_dark_input" />
            <stroke android:width="1.5dp" android:color="@color/color_auth_primary" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Default/Normal State -->
    <item>
        <shape>
            <solid android:color="@color/bg_dark_input" />
            <stroke android:width="1dp" android:color="@color/border_dark" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- L-shaped corner bracket — detected/green state -->
    <!-- Vertical bar -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="20dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#10B981" />
            <size android:width="4dp" android:height="32dp" />
        </shape>
    </item>
    <!-- Horizontal bar -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="24dp">
        <shape android:shape="rectangle">
            <solid android:color="#10B981" />
            <size android:width="32dp" android:height="4dp" />
        </shape>
    </item>
</layer-list>

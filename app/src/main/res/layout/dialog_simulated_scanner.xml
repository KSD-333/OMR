<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF09090B">

    <!-- Mock Camera Preview Grid Backdrop -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.2"
        android:src="@drawable/bg_preview_paper" />

    <!-- Real Image Preview selected by user -->
    <ImageView
        android:id="@+id/imgStudentSheetPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.4"
        android:contentDescription="Student Sheet Preview" />

    <!-- Scanner Toolbar Header -->
    <RelativeLayout
        android:id="@+id/layoutScannerHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txtScannerOverlayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="OMR Scanner"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="AUTO MODE"
            android:textColor="#10B981"
            android:textStyle="bold"
            android:textSize="12sp" />
    </RelativeLayout>

    <!-- Center Alignment Frame Boundary -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutAlignmentFrame"
        android:layout_width="280dp"
        android:layout_height="390dp"
        android:background="@drawable/bg_selected_scan_card"
        app:layout_constraintTop_toBottomOf="@id/layoutScannerHeader"
        app:layout_constraintBottom_toTopOf="@id/txtScanTip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Custom Registration Targets inside corners -->
        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="#3B82F6"
            android:layout_margin="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="#3B82F6"
            android:layout_margin="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="#3B82F6"
            android:layout_margin="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="#3B82F6"
            android:layout_margin="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Mock Scanner laser line animation -->
        <View
            android:id="@+id/scanLaserLine"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#10B981"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Scanner Successful Grade Results Card (Shown after scan complete) -->
        <LinearLayout
            android:id="@+id/layoutScanSuccessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E6064E3B"
            android:padding="20dp"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_scan"
                app:tint="#10B981"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan Successful!"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Diagnostic score indicators -->
            <TextView
                android:id="@+id/txtScanStudentID"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student ID: 203495"
                android:textColor="#A7F3D0"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtScanScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Score: 86 / 100"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtScanCorrectIncorrect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correct: 43  |  Incorrect: 7"
                android:textColor="#A7F3D0"
                android:textSize="12sp"
                android:layout_marginBottom="24dp"
                android:gravity="center" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFinishScan"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill_button"
                android:backgroundTint="#10B981"
                android:text="Done &amp; Save Scan"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textAllCaps="false"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scan Progress Overlay -->
    <LinearLayout
        android:id="@+id/layoutScanningProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_rounded_card"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/layoutAlignmentFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/txtScanTip">

        <ProgressBar
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="@color/dashboard_card_teal"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/txtScanningStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detecting OMR sheet markings..."
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scan Tip Instruction Label -->
    <TextView
        android:id="@+id/txtScanTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Align A4 OMR sheet boundaries inside frame"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

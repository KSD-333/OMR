<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardKeyRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#27272A"
    app:cardBackgroundColor="#1C1C21">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <!-- Active Checkmark Indicator / Key Icon -->
        <ImageView
            android:id="@+id/imgRowIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_key"
            app:tint="@color/dashboard_card_teal"
            android:layout_marginEnd="16dp" />

        <!-- Key Info Text -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtRowKeyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Midterm Exam Answer Key"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/txtRowKeyDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100 Questions · 4-Column Layout"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Use/Selected Checkmark Icon -->
        <ImageView
            android:id="@+id/imgRowCheck"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check"
            app:tint="@color/color_success"
            android:visibility="gone"
            android:layout_marginEnd="16dp" />

        <!-- Action: Edit Button -->
        <TextView
            android:id="@+id/btnRowEdit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Edit"
            android:textColor="#3B82F6"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="8dp" />

        <!-- Action: Delete Button -->
        <ImageView
            android:id="@+id/btnRowDelete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/color_error"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete key" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

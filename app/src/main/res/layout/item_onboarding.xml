<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <!-- Icon Container Center Layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutIconContainer"
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="40dp">

        <!-- Outer Glowing Circle -->
        <View
            android:id="@+id/imgCircleBg"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:background="@drawable/bg_rounded_card"
            android:backgroundTint="@color/color_page_1_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Vector Icon -->
        <ImageView
            android:id="@+id/imgIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_sheet"
            app:layout_constraintTop_toTopOf="@id/imgCircleBg"
            app:layout_constraintBottom_toBottomOf="@id/imgCircleBg"
            app:layout_constraintStart_toStartOf="@id/imgCircleBg"
            app:layout_constraintEnd_toEndOf="@id/imgCircleBg" />

        <!-- Page Number Badge (top-right overlapping circle) -->
        <TextView
            android:id="@+id/txtPageBadge"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/dot_active"
            android:backgroundTint="@color/color_page_1"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/imgCircleBg"
            app:layout_constraintEnd_toEndOf="@id/imgCircleBg"
            android:layout_marginTop="-4dp"
            android:layout_marginEnd="-4dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Slide Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutIconContainer"
        app:layout_constraintBottom_toTopOf="@id/txtDescription"
        tools:text="Generate Answer Sheets" />

    <!-- Slide Description -->
    <TextView
        android:id="@+id/txtDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:lineSpacingExtra="5sp"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="Create custom OMR bubble sheets in seconds. Choose questions count, columns, and add your institute name — then download as PDF, ready to print." />

</androidx.constraintlayout.widget.ConstraintLayout>

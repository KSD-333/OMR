<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF09090B">

    <!-- Live Camera Preview View (Full Screen) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:scaleType="fillCenter" />

    <!-- Dynamic Document Overlay (Draws blue polygon over detected paper) -->
    <com.mk.omrscanner.DocumentOverlayView
        android:id="@+id/documentOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scanner laser line animation with glow (Full Width) -->
    <View
        android:id="@+id/cameraLaserLine"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@drawable/bg_laser_glow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Top Toolbar Header -->
    <RelativeLayout
        android:id="@+id/layoutCameraHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        android:background="#B3000000"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnCameraClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_delete"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/txtCameraScannerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="OMR Live Scan"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtCameraScannerMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="AUTO DETECT"
            android:textColor="#3B82F6"
            android:textStyle="bold"
            android:textSize="12sp" />
    </RelativeLayout>

    <!-- Status Text Feedback Pill -->
    <TextView
        android:id="@+id/txtScanStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📋 Looking for document edges..."
        android:textColor="#F4F4F5"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_status_pill"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/txtCameraScanTip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scanner Tip Instruction Label -->
    <TextView
        android:id="@+id/txtCameraScanTip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Place OMR sheet on a contrasting background · Hold steady"
        android:textColor="#71717A"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

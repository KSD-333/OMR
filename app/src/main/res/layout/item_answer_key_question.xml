<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp">

    <!-- Question Number -->
    <TextView
        android:id="@+id/txtQuestionNum"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:text="1"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Bubble Option Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="4dp">

        <!-- Option A -->
        <TextView
            android:id="@+id/btnOptA"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="A"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_bubble_selector" />

        <View
            android:layout_width="16dp"
            android:layout_height="0dp" />

        <!-- Option B -->
        <TextView
            android:id="@+id/btnOptB"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="B"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_bubble_selector" />

        <View
            android:layout_width="16dp"
            android:layout_height="0dp" />

        <!-- Option C -->
        <TextView
            android:id="@+id/btnOptC"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="C"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_bubble_selector" />

        <View
            android:layout_width="16dp"
            android:layout_height="0dp" />

        <!-- Option D -->
        <TextView
            android:id="@+id/btnOptD"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="D"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_bubble_selector" />

    </LinearLayout>

    <!-- Points Badge -->
    <TextView
        android:id="@+id/badgePoints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1pt"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:background="@drawable/bg_badge_points"
        android:clickable="true"
        android:focusable="true"
        android:layout_gravity="center_vertical" />

</LinearLayout>

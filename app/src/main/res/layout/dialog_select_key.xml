<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_collapsible_card"
    android:padding="20dp">

    <!-- Header Title -->
    <TextView
        android:id="@+id/txtDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Answer Key"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Close icon -->
    <TextView
        android:id="@+id/btnDialogClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Close"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:padding="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scrollable container for keys -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/dialogScrollKeys"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtDialogTitle"
        app:layout_constraintBottom_toTopOf="@id/btnDialogCreateKey">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Empty State Placeholder -->
            <TextView
                android:id="@+id/txtDialogEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No saved keys found.\nCreate one below to get started!"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:layout_marginVertical="60dp"
                android:lineSpacingExtra="4dp"
                android:visibility="gone" />

            <!-- Keys list container -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDialogKeys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_saved_key_row"
                tools:itemCount="3" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Create New Answer Key Action Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDialogCreateKey"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_gradient_button"
        android:text="+  Create New Answer Key"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/dialogScrollKeys"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
